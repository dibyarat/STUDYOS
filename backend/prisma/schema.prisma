generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  CR
  DEVELOPER
}

enum StudentType {
  HOSTELLER
  DAY_SCHOLAR
}

enum RoomStatus {
  FREE_BY_TIMETABLE
  OCCUPIED_BY_TIMETABLE
  REPORTED_FREE
  UNKNOWN_STALE
  MAINTENANCE
}

enum AttendanceState {
  PRESENT
  ABSENT
  NOT_UPDATED
  UNKNOWN
  REQUESTED
}

enum SubmissionType {
  ASSIGNMENT
  LAB_RECORD
  PRACTICAL_FILE
  PROJECT
  VIVA_FILE
  PRINTED_FORM
  DOCUMENT
  OTHER
}

enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  SUBMITTED_DIGITALLY
  SUBMITTED_PHYSICALLY
  COLLECTED
  WITH_FACULTY
  RETURNED
  REJECTED_CORRECTION_REQUIRED
  UNKNOWN
}

enum ReminderCategory {
  EXAM
  VIVA
  ASSIGNMENT
  LAB
  PROJECT
  FEE
  EVENT
  REGISTRATION
  SCHOLARSHIP
  DOCUMENT
  ATTENDANCE
  OTHER
}

enum Priority {
  LOW
  NORMAL
  IMPORTANT
  URGENT
}

enum ReminderSchedule {
  ONE_DAY
  TWELVE_HOURS
  THREE_HOURS
  ONE_HOUR
  CUSTOM
}

enum TargetAudience {
  COLLEGE
  DEPARTMENT
  SEMESTER
  SECTION
  INDIVIDUAL
}

// ------------------------------
// IDENTITY
// ------------------------------

model Institution {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  users     User[]
  sections  Section[]
  createdAt DateTime  @default(now())
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile       Profile?
  crAssignment  CrAssignment?
  student       Student?
  pollVotes     PollVote[]
  auditLogs     AuditLog[]
  notifications Notification[] @relation("UserNotifications")
  Institution   Institution?   @relation(fields: [institutionId], references: [id])
  institutionId String?

  name      String?
  avatarUrl String?

  academicIdentity        AcademicIdentity?
  resources               Resource[]
  virtualClasses          VirtualStudyClass[]
  projects                Project[]
  teamPosts               TeamPost[]
  teamMemberships         TeamMembership[]
  skills                  StudentSkill[]
  helpServices            HelpService[]
  helpRequests            HelpRequest[]        @relation("HelprequestsMade")
  helpTasks               HelpRequest[]        @relation("HelprequestsAccepted")
  messages                Message[]
  resourceSaves           ResourceSave[]
  resourceRatings         ResourceRating[]
  conversationMemberships ConversationMember[]
  teamJoinRequests        TeamJoinRequest[]
  labUploads              LabRecord[]
  resourceReports         ResourceReport[]
  serviceReviews          ServiceReview[]      @relation("Reviewer")
  serviceReviewsReceived  ServiceReview[]      @relation("ReviewedService")
}

model Profile {
  id         String  @id @default(uuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  avatarUrl  String?
  studentId  String  @unique
  rollNumber String?
  department String?
  semester   String?
  section    String?

  studentType StudentType @default(DAY_SCHOLAR)
  hostelName  String?
  hostelBlock String?
  hostelRoom  String?

  github    String?
  linkedin  String?
  portfolio String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Backreferences for student-specific data
  attendanceRecords  AttendanceRecord[]
  attendanceRequests AttendanceRequest[]
  submissions        Submission[]
}

model CrAssignment {
  id        String       @id @default(uuid())
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sectionId String
  section   Section      @relation(fields: [sectionId], references: [id])
  termId    String
  term      AcademicTerm @relation(fields: [termId], references: [id])

  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sectionId, isActive])
}

// ------------------------------
// ACADEMIC MASTER
// ------------------------------

model Department {
  id       String    @id @default(uuid())
  name     String    @unique
  code     String    @unique
  sections Section[]
}

model Semester {
  id       String    @id @default(uuid())
  number   Int       @unique
  name     String
  sections Section[]
}

model Section {
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  id            String       @id @default(uuid())
  name          String
  departmentId  String
  department    Department   @relation(fields: [departmentId], references: [id])
  semesterId    String
  semester      Semester     @relation(fields: [semesterId], references: [id])

  crAssignments CrAssignment[]
  subjects      SubjectSection[]
  timetable     TimetableEntry[]
}

model Subject {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  credits     Int
  type        String // Theory, Practical
  sections    SubjectSection[]
  timetable   TimetableEntry[]
  exams       Exam[]
  submissions Submission[]
}

model SubjectSection {
  subjectId String
  sectionId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  section   Section @relation(fields: [sectionId], references: [id])

  @@id([subjectId, sectionId])
}

model AcademicTerm {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  crAssignments CrAssignment[]
  timetable     TimetableEntry[]
  exams         Exam[]
}

// ------------------------------
// TIMETABLE
// ------------------------------

model TimetableEntry {
  id        String       @id @default(uuid())
  subjectId String
  subject   Subject      @relation(fields: [subjectId], references: [id])
  sectionId String
  section   Section      @relation(fields: [sectionId], references: [id])
  roomId    String?
  room      Room?        @relation(fields: [roomId], references: [id])
  termId    String
  term      AcademicTerm @relation(fields: [termId], references: [id])

  facultyRef String?
  dayOfWeek  Int // 0 = Sunday, 1 = Monday, etc.
  startTime  String // HH:mm
  endTime    String // HH:mm
  status     String  @default("ACTIVE") // ACTIVE, CANCELLED
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------
// ROOMS
// ------------------------------

model Room {
  id         String     @id @default(uuid())
  roomNumber String     @unique
  building   String?
  block      String?
  floor      String?
  capacity   Int        @default(0)
  isAC       Boolean    @default(false)
  isLab      Boolean    @default(false)
  equipment  String?
  status     RoomStatus @default(FREE_BY_TIMETABLE)
  notes      String?

  timetable   TimetableEntry[]
  roomReports RoomReport[]
  exams       Exam[]
}

model RoomReport {
  id         String     @id @default(uuid())
  roomId     String
  room       Room       @relation(fields: [roomId], references: [id])
  reportedBy String
  status     RoomStatus
  notes      String?
  createdAt  DateTime   @default(now())
}

// ------------------------------
// ATTENDANCE
// ------------------------------

model AttendanceRecord {
  id         String          @id @default(uuid())
  studentId  String
  student    Student         @relation(fields: [studentId], references: [id])
  subjectRef String // Subject Code
  date       DateTime
  state      AttendanceState
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model AttendanceRequest {
  id          String    @id @default(uuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id])
  subjectRef  String
  sessionDate DateTime
  reason      String
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED, RESOLVED
  reviewerId  String?
  reviewNote  String?
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AttendanceRule {
  id            String  @id @default(uuid())
  targetPercent Float   @default(75.0)
  active        Boolean @default(true)
}

// ------------------------------
// EXAMS
// ------------------------------

model Exam {
  id        String       @id @default(uuid())
  subjectId String
  subject   Subject      @relation(fields: [subjectId], references: [id])
  roomId    String?
  room      Room?        @relation(fields: [roomId], references: [id])
  termId    String
  term      AcademicTerm @relation(fields: [termId], references: [id])

  examType  String
  date      DateTime
  startTime String
  endTime   String
  notes     String?
  status    String   @default("SCHEDULED")

  seatings ExamSeating[]
}

model ExamSeating {
  id          String  @id @default(uuid())
  examId      String
  exam        Exam    @relation(fields: [examId], references: [id])
  rollNumber  String
  studentId   String?
  studentName String?
  roomHall    String
  seat        String
  row         String?
  column      String?

  @@unique([examId, rollNumber])
  @@unique([examId, roomHall, seat])
}

// ------------------------------
// PRODUCTIVITY
// ------------------------------

model Submission {
  id        String  @id @default(uuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  title         String
  type          SubmissionType
  status        SubmissionStatus @default(NOT_SUBMITTED)
  deadline      DateTime?
  submittedDate DateTime?
  facultyRef    String?
  isDigital     Boolean          @default(false)
  fileReference String?
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reminder {
  id          String           @id @default(uuid())
  category    ReminderCategory
  priority    Priority         @default(NORMAL)
  schedule    ReminderSchedule
  target      TargetAudience
  title       String
  description String?
  dueDate     DateTime
  creatorId   String

  createdAt DateTime @default(now())
}

model Poll {
  id          String         @id @default(uuid())
  title       String
  description String?
  target      TargetAudience
  status      String         @default("ACTIVE")
  creatorId   String
  startDate   DateTime       @default(now())
  endDate     DateTime?

  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id     String @id @default(uuid())
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String

  votes PollVote[]
}

model PollVote {
  id       String     @id @default(uuid())
  pollId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([pollId, userId]) // Enforce 1 vote per user per poll
}

// ------------------------------
// SYSTEM
// ------------------------------

model AuditLog {
  id         String  @id @default(uuid())
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userRole   String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  status     String
  ipAddress  String?

  timestamp DateTime @default(now())
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// ------------------------------
// NOTIFICATIONS
// ------------------------------

model Notification {
  id                String   @id @default(uuid())
  recipientId       String
  user              User     @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  type              String // ATTENDANCE_REMINDER, CLASS_CANCELLED, etc.
  title             String
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  isRead            Boolean  @default(false)
  createdAt         DateTime @default(now())
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  content     String
  target      String // COLLEGE, DEPARTMENT, SECTION
  priority    Priority  @default(NORMAL)
  creatorId   String
  isPublished Boolean   @default(true)
  publishDate DateTime  @default(now())
  expiryDate  DateTime?
  createdAt   DateTime  @default(now())
}

// ------------------------------
// STUDYOS & RESOURCES
// ------------------------------

model AcademicResource {
  id            String   @id @default(uuid())
  title         String
  type          String // LAB_PDF, ASSIGNMENT_FORMAT
  subjectId     String?
  fileReference String
  uploaderId    String
  createdAt     DateTime @default(now())
}

model StudyOSResource {
  id            String   @id @default(uuid())
  title         String
  subjectId     String?
  category      String
  fileReference String
  uploaderId    String
  createdAt     DateTime @default(now())
}

model LabRecord {
  id            String   @id @default(uuid())
  experimentNo  Int?
  name          String
  description   String?
  aim           String?
  procedure     String?
  code          String?
  output        String?
  subjectId     String?
  fileReference String?
  fileName      String?
  fileMimeType  String?
  fileSize      Int?
  uploaderId    String?
  uploader      User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
}

model AcademicIdentity {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  degree         String?
  stream         String?
  branch         String?
  specialization String?
  institution    String?
  year           String?
  semester       String?
  session        String?
  github         String?
  linkedin       String?
  portfolio      String?
  isPublic       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Resource {
  id            String   @id @default(uuid())
  title         String
  description   String?
  type          String
  subject       String?
  topic         String?
  visibility    String   @default("PRIVATE") // PUBLIC or PRIVATE
  price         Float?
  paymentMethod String?
  upiId         String?
  paymentInst   String?
  creatorId     String
  creator       User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  files          ResourceFile[]
  links          ResourceLink[]
  tags           ResourceTag[]
  saves          ResourceSave[]
  ratings        ResourceRating[]
  reports        ResourceReport[]
  classResources VirtualStudyResource[]
}

model ResourceFile {
  id         String   @id @default(uuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  fileUrl    String
  fileName   String
  fileSize   Int?
  mimeType   String?
  createdAt  DateTime @default(now())
}

model ResourceLink {
  id         String   @id @default(uuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  url        String
  title      String?
  createdAt  DateTime @default(now())
}

model ResourceTag {
  id         String   @id @default(uuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag        String
}

model ResourceSave {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, resourceId])
}

model ResourceRating {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  rating     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, resourceId])
}

model ResourceReport {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId  String
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  reason      String
  description String?
  status      String   @default("PENDING") // PENDING, REVIEWED, RESOLVED, DISMISSED
  createdAt   DateTime @default(now())
}

model VirtualStudyClass {
  id          String   @id @default(uuid())
  name        String
  description String?
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics VirtualStudyTopic[]
}

model VirtualStudyTopic {
  id        String            @id @default(uuid())
  classId   String
  class     VirtualStudyClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  name      String
  order     Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  resources VirtualStudyResource[]
}

model VirtualStudyResource {
  id         String            @id @default(uuid())
  topicId    String
  topic      VirtualStudyTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  resourceId String?
  resource   Resource?         @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  notes      String?
  createdAt  DateTime          @default(now())
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String
  technology  String?
  githubUrl   String?
  demoUrl     String?
  visibility  String   @default("PUBLIC")
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  files ProjectFile[]
  tags  ProjectTag[]
}

model ProjectFile {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileName  String
  createdAt DateTime @default(now())
}

model ProjectTag {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       String
}

model TeamPost {
  id           String    @id @default(uuid())
  title        String
  type         String
  description  String?
  reqSkills    String?
  requirements String?
  roles        Json?
  teamSize     Int?
  deadline     DateTime?
  creatorId    String
  creator      User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships TeamMembership[]
  requests    TeamJoinRequest[]
}

model TeamMembership {
  id        String   @id @default(uuid())
  teamId    String
  team      TeamPost @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // CREATOR, MEMBER
  position  String?
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
}

model TeamJoinRequest {
  id              String   @id @default(uuid())
  teamId          String
  team            TeamPost @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, WITHDRAWN
  roleAppliedFor  String?
  applicationData Json?
  recruiterNotes  String?
  createdAt       DateTime @default(now())

  @@unique([teamId, userId])
}

model Skill {
  id       String         @id @default(uuid())
  name     String         @unique
  students StudentSkill[]
}

model StudentSkill {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency  String   @default("BEGINNER")
  experience   String?
  portfolioUrl String?
  createdAt    DateTime @default(now())

  @@unique([userId, skillId])
}

model HelpService {
  id                  String   @id @default(uuid())
  title               String
  description         String?
  category            String?
  isPaid              Boolean  @default(false)
  price               Float?
  skills              String?
  deliverables        String?
  availability        String?
  preferredSchedule   String?
  responseTime        String?
  expectedTimeline    String?
  paymentMethod       String?
  upiId               String?
  paymentQrUrl        String?
  paymentInstructions String?
  providerId          String
  provider            User     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  requests HelpRequest[]
  reviews  ServiceReview[]
}

model HelpRequest {
  id                  String       @id @default(uuid())
  serviceId           String?
  service             HelpService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  requesterId         String
  requester           User         @relation("HelprequestsMade", fields: [requesterId], references: [id], onDelete: Cascade)
  providerId          String
  provider            User         @relation("HelprequestsAccepted", fields: [providerId], references: [id], onDelete: Cascade)
  status              String       @default("PENDING") // PENDING, ACCEPTED, IN_PROGRESS, COMPLETED, REJECTED, CANCELLED
  message             String?
  triedSoFar          String?
  projectContext      String?
  expectedOutcome     String?
  preferredDate       DateTime?
  communicationMethod String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  review ServiceReview?

  @@unique([requesterId, serviceId])
  @@index([providerId, status])
  @@index([requesterId, status])
}

model ServiceReview {
  id            String      @id @default(uuid())
  helpRequestId String      @unique
  helpRequest   HelpRequest @relation(fields: [helpRequestId], references: [id], onDelete: Cascade)
  serviceId     String
  service       HelpService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      User        @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  providerId    String
  provider      User        @relation("ReviewedService", fields: [providerId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
}

model Conversation {
  id          String               @id @default(uuid())
  contextType String?
  contextId   String?
  contextKey  String?              @unique
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     ConversationMember[]
  messages    Message[]
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}
